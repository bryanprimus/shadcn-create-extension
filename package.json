    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "^0.7.1",
